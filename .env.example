# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, add these in:
#   Project → Settings → Environment Variables
# Enable for Production AND Preview, then redeploy.

# MongoDB connection string (required on Vercel)
MONGODB_URI="mongodb+srv://username:password@cluster0.exqf3.mongodb.net/matrix_mobiles?retryWrites=true&w=majority"

# JWT signing secret (required on Vercel — use a long random string in production)
JWT_SECRET="matrix-mobiles-super-secret-key"

# --- AI chat (pick ONE) ---
# Option A (recommended for free Nvidia model): OpenRouter
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"

# Option B: NVIDIA build.nvidia.com / NGC key
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=""

# Primary model (OpenRouter free slug). For NVIDIA NIM the ":free" suffix is stripped automatically.
AI_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Fallback models tried in order when the primary hits rate-limit / temporary errors.
# Note: embedding-only models (names containing "embed") are skipped for chat.
AI_FALLBACK_MODELS="openai/gpt-oss-20b:free,nvidia/nemotron-3-embed-1b:free"

# Public app URL (optional — auto-detected from VERCEL_URL on Vercel)
APP_URL="http://localhost:3000"

# Legacy / unused by current app (safe to omit)
GEMINI_API_KEY=""
